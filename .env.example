# Telegram bot token
BALE_TOKEN=your_bale_bot_token

# PostgreSQL connection URL
DATABASE_URL=postgresql://bale_bot:secret@localhost:5432/bale_bot
DB_MIN_POOL=2
DB_MAX_POOL=20

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Admin configuration
ADMIN_ID=123456789

# Payment settings
PROVIDER_TOKEN=your_provider_token
PAYMENT_VALUE=500000

# Usage limits
USER_LIMIT_VALUE=2
VIP_LIMIT_VALUE=20

# Telethon session
SESSION_NAME=ai-session-name
API_ID=your_api_id
API_HASH=your_api_hash
SCIHUB_BOT_USERNAME=your_scihub_bot_username

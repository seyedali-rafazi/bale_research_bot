# Telegram bot token
BALE_TOKEN=your_bale_bot_token

# PostgreSQL connection URL
DATABASE_URL=postgresql://bale_bot:secret@localhost:5432/bale_bot
DB_MIN_POOL=10
DB_MAX_POOL=50

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Admin configuration
ADMIN_ID=123456789

# Channel guard (leave REQUIRED_CHANNEL empty to disable)
REQUIRED_CHANNEL=@your_channel_username
CHANNEL_INVITE_LINK=https://ble.ir/your_channel

# Payment settings
PROVIDER_TOKEN=your_provider_token
PAYMENT_VALUE=500000

# Usage limits
USER_LIMIT_VALUE=2
VIP_LIMIT_VALUE=20

# Telethon session
SESSION_NAME=ai-session-name
API_ID=your_api_id
API_HASH=your_api_hash
SCIHUB_BOT_USERNAME=your_scihub_bot_username
CHATGPT_BOT_USERNAME=your_chatgpt_bot_username

# HTTP client (OpenAlex, Unpaywall, book APIs)
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_LIMIT=100
HTTP_CONNECT_PER_HOST=30
UNPAYWALL_EMAIL=your_email@example.com

# Telethon concurrency (shared session, limited parallel ops)
TELETHON_SCIHUB_CONCURRENCY=3
TELETHON_AI_CONCURRENCY=5
SCIHUB_REPLY_TIMEOUT=45
